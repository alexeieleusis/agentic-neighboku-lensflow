# dotharness configuration for one track repo — DO NOT COMMIT the filled-in
# copy of this file. Add ".harness.toml" to your global gitignore, not this
# repo's (matches dotharness's own convention — see the real examples this
# template is based on: ~/development/vibe-heal/.harness.toml,
# ~/.harness/.harness-pr_review.toml).
#
# Usage: copy this file to <review_clone>/.harness.toml and fill in the two
# <...> placeholders below. Every other value is a real, working setting for
# this machine (confirmed 2026-08-09/2026-08-10) — leave it as-is unless it
# actually breaks. Pass this file's path to orchestrate's --harness-config.

[harness]
backend = "opencode"               # "opencode" or "claude" — this project uses opencode
gh_token_cmd = "gh auth token"
backend_timeout_seconds = 900
knowledge_dir = "~/.harness/knowledge"

# Optional keys not needed by this project (single TS/JS package, no extra toolchain):
# [harness.path_prepend]/[harness.env] (per-language PATH/env vars), review_knowledge_file.
# See dotharness's own config reference if you need them.

[repo]
name = "<owner>/<repo>"                      # e.g. alexeieleusis/neighboku-ai-baseline
working_dir = "<absolute-path-to-review-clone>"

[vibe_heal]
enabled = true
python = "/home/alexeieleusis/development/vibe-heal/.venv/bin/python3"
authors = "*"
vibe_heal_timeout = 600
vibe_heal_post_timeout = 120

[focused_review]
enabled = true
# vibe_types_repo defaults to ~/.harness/vendor/vibe-types

# Optional: [address_comments] (PR-comment-triggered re-review tuning) and [[repo.subdir]]
# (multi-package repo support) — not needed for this single-package project.
