# vibe-heal configuration for one track repo — DO NOT COMMIT the filled-in
# copy of this file (same convention as .harness.toml). Based on the real,
# working config at ~/development/vibe-heal/.env.vibeheal.self.
#
# Usage: copy this file to <review_clone>/.env.vibeheal and fill in the two
# <...> placeholders below. Pass this file's path to orchestrate's
# --vibe-heal-env-file.

# ============================================================================
# SonarQube Configuration (REQUIRED)
# ============================================================================

# This machine's local SonarQube server (confirmed working 2026-08-09) — no
# trailing slash. Change this only if you're not running on this machine.
SONARQUBE_URL=http://localhost:9000

# One project per track repo — vibe-heal creates it automatically on first
# scan if it doesn't already exist on the server, so this just needs to be a
# unique, stable name (e.g. matching the repo name).
SONARQUBE_PROJECT_KEY=<neighboku-ai-baseline-or-neighboku-ai-lensflow>

# Token auth (preferred over username/password). Mint a project- or
# user-scoped token in the SonarQube UI, or reuse the one already confirmed
# working on this machine — see SONARQUBE_TOKEN in
# ~/development/vibe-heal/.env.vibeheal.self (not copied here since this
# file may end up committed as a template; that one is itself gitignored).
SONARQUBE_TOKEN=<sonarqube-token>

# opencode is the AI tool already confirmed working on this machine for the
# harness backend — keep vibe-heal's own choice consistent with it.
AI_TOOL=opencode
